NODE_ENV=development
HOST=127.0.0.1
PORT=8081
TRUST_PROXY=false
SSO_ISSUER=https://auth.legacyhosting.xyz
SSO_AUDIENCE=lh-hub
SSO_JWKS_URL=https://auth.legacyhosting.xyz/.well-known/jwks.json
SERVICE_HEALTH_TARGETS='[{"key":"panel","name":"Control panel","url":"https://panel.legacyhosting.xyz/"},{"key":"api","name":"API","url":"https://api.legacyhosting.xyz/health"},{"key":"identity","name":"Identity","url":"https://auth.legacyhosting.xyz/health"},{"key":"status","name":"Public status","url":"https://status.legacyhosting.xyz/health"}]'
SERVICE_HEALTH_TIMEOUT_MS=5000
