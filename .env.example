NODE_ENV=development
HOST=127.0.0.1
PORT=8081
TRUST_PROXY=false
SSO_ISSUER=https://auth.legacyhosting.xyz
SSO_AUDIENCE=lh-hub
SSO_JWKS_URL=https://auth.legacyhosting.xyz/jwks
SSO_CLIENT_ID=lh-hub
SSO_CLIENT_SECRET=replace-with-at-least-32-random-characters
SSO_REDIRECT_URI=https://hub.legacyhosting.xyz/auth/callback
SSO_RESOURCE=https://hub.legacyhosting.xyz
SSO_REQUEST_TIMEOUT_MS=5000
HUB_ORIGIN=https://hub.legacyhosting.xyz
HUB_SESSION_TTL_SECONDS=28800
API_ORIGIN=https://api.legacyhosting.xyz
API_REQUEST_TIMEOUT_MS=5000
STATUS_API_URL=https://status.legacyhosting.xyz/api/v1/status
SERVICE_HEALTH_TARGETS='[{"key":"panel","name":"Control panel","url":"https://panel.legacyhosting.xyz/"},{"key":"api","name":"API","url":"https://api.legacyhosting.xyz/health"},{"key":"identity","name":"Identity","url":"https://auth.legacyhosting.xyz/health"},{"key":"status","name":"Public status","url":"https://status.legacyhosting.xyz/health"}]'
SERVICE_HEALTH_TIMEOUT_MS=5000
# Optional at first boot. Add a read-only DigitalOcean token to enable infrastructure metrics.
# DIGITALOCEAN_TOKEN=replace-with-read-only-scoped-token
DIGITALOCEAN_REQUEST_TIMEOUT_MS=5000
DIGITALOCEAN_CACHE_TTL_MS=120000
DIGITALOCEAN_METRIC_WINDOW_SECONDS=900
